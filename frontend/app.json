{
  "expo": {
    "name": "Chadivimpulu",
    "slug": "gift-register",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "giftregister",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#002366"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.emergent.giftregister",
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "Save QR codes and reports to your gallery"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#002366"
      },
      "package": "app.emergent.giftregister",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA"
      ]
    },
    "androidStatusBar": {
      "backgroundColor": "#002366",
      "barStyle": "light-content"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-media-library",
        {
          "photosPermission": "Save QR codes to your photo gallery",
          "savePhotosPermission": "Save QR codes and reports to gallery",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
